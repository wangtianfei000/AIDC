import { useEffect, useMemo, useRef, useState } from 'react';
import { Activity, AlertTriangle, Box, Camera, CheckCircle2, ChevronDown, ChevronLeft, ChevronRight, Crosshair, Download, Eye, EyeOff, Focus, Maximize2, Move3d, Pause, Play, RefreshCw, RotateCcw, Save, ShieldAlert, Tags, Upload, Wrench } from 'lucide-react';
import * as THREE from 'three';
import { OrbitControls } from 'three/examples/jsm/controls/OrbitControls.js';
import { GLTFLoader } from 'three/examples/jsm/loaders/GLTFLoader.js';
import { INTERFERENCE_REPORT_SCHEMA_VERSION, type AssemblySequence, type InterferencePairResult, type Model3DManifest, type Vec3 } from '@aidc/model3d-contracts';
import { AssemblyRig, loadRobotModel, RobotRig } from '@aidc/model3d-three-runtime';
import { componentIdForElement, elementByComponentId, resolveModel3D } from '../model3d/registry';
import { interpolatePose, isAtJointLimit, jointLabel, standardPosePresets, type JointPose } from '../model3d/motion';
import { collectCollisionProxies, detectInterferences, formatDistance, refreshCollisionProxies, type CollisionProxy } from '../model3d/collision';
import { exactCheck } from '../model3d/exactCheck';
import {
  applyDisplayState, componentIdFromObject, componentObjects, defaultModel3DViewState, disposeObject3D,
  parseModel3DViewState, prepareMaterials, type Model3DViewState,
} from '../model3d/runtime';
import type { BrowserViewContext, BrowserViewDefinition } from './viewRegistry';

type Projection = Model3DViewState['projection'];
type LoadStatus = { phase: 'loading' | 'ready' | 'error'; message: string; progress?: number };
type ComponentEntry = { componentId: string; label: string; bodyId?: string; geometryStatus?: string };
type PhysicalEntry = { bodyId: string; label: string; parentBodyId?: string; componentIds: string[] };
type PhysicalRow = PhysicalEntry & { depth: number; hasChildren: boolean };

interface ViewerEnvironment {
  scene: THREE.Scene;
  renderer: THREE.WebGLRenderer;
  perspective: THREE.PerspectiveCamera;
  orthographic: THREE.OrthographicCamera;
  activeCamera: THREE.PerspectiveCamera | THREE.OrthographicCamera;
  controls: OrbitControls;
  displayRoot?: THREE.Object3D;
  modelRoot?: THREE.Object3D;
  components: Map<string, THREE.Object3D>;
  bodies: Map<string, THREE.Object3D>;
  rig?: RobotRig;
  assemblyRig?: AssemblyRig;
  assemblyFrame?: number;
  bomLabels?: THREE.Group;
  ghostRoot?: THREE.Object3D;
  trajectory?: THREE.Line;
  trajectoryPoints: THREE.Vector3[];
  collisionProxies: CollisionProxy[];
  collisionHelpers: THREE.Box3Helper[];
  motionFrame?: number;
  selectionMeshes: THREE.Mesh[];
  floor: THREE.Mesh;
  grid: THREE.GridHelper;
  frame: number;
}

function Model3DBrowserView(context: BrowserViewContext) {
  const hostRef = useRef<HTMLDivElement>(null);
  const fileRef = useRef<HTMLInputElement>(null);
  const envRef = useRef<ViewerEnvironment | undefined>(undefined);
  const initial = useMemo(() => parseModel3DViewState(context.viewState), []);
  const contextElement = context.query.byId.get(context.viewContextId ?? context.selectedId ?? '') ?? context.selected;
  const resolved = useMemo(() => resolveModel3D(contextElement, context.query), [contextElement, context.query]);
  const sysmlByComponent = useMemo(() => elementByComponentId(context.query), [context.query]);
  const [localFiles, setLocalFiles] = useState<File[]>();
  const [status, setStatus] = useState<LoadStatus>({ phase: 'loading', message: '正在准备三维场景…' });
  const [manifest, setManifest] = useState<Model3DManifest>();
  const [entries, setEntries] = useState<ComponentEntry[]>([]);
  const [bodyEntries, setBodyEntries] = useState<PhysicalEntry[]>([]);
  const [selectedBodyId, setSelectedBodyId] = useState<string>();
  const [expandedBodies, setExpandedBodies] = useState(() => new Set<string>());
  const [selectedComponentId, setSelectedComponentId] = useState(initial.selectedComponentId ?? componentIdForElement(context.selected, context.query) ?? resolved?.focusComponentId);
  const [hidden, setHidden] = useState(() => new Set(initial.hiddenComponentIds));
  const [isolated, setIsolated] = useState(initial.isolatedComponentId);
  const [transparent, setTransparent] = useState(initial.transparent);
  const [wireframe, setWireframe] = useState(initial.wireframe);
  const [projection, setProjection] = useState<Projection>(initial.projection);
  const [jointValues, setJointValues] = useState<JointPose>(initial.jointValues);
  const [selectedJointId, setSelectedJointId] = useState(initial.selectedJointId);
  const [motionPanel, setMotionPanel] = useState(false);
  const [collisionPanel, setCollisionPanel] = useState(false);
  const [assemblyPanel, setAssemblyPanel] = useState(false);
  const [collisionEnabled, setCollisionEnabled] = useState(true);
  const [collisionResults, setCollisionResults] = useState<InterferencePairResult[]>([]);
  const [collisionFilter, setCollisionFilter] = useState<'active' | 'all'>('active');
  const [selectedPairId, setSelectedPairId] = useState<string>();
  const [exactChecking, setExactChecking] = useState(false);
  const [exactMessage, setExactMessage] = useState('');
  const [assemblySequence, setAssemblySequence] = useState<AssemblySequence>();
  const [explosionFactor, setExplosionFactor] = useState(initial.explosionFactor);
  const [explosionDistance, setExplosionDistance] = useState(.12);
  const [assemblyPosition, setAssemblyPosition] = useState(initial.assemblyPosition);
  const [assemblyDirection, setAssemblyDirection] = useState<'disassembly' | 'assembly'>('disassembly');
  const [assemblyPlaying, setAssemblyPlaying] = useState(false);
  const [bomLabelsEnabled, setBomLabelsEnabled] = useState(initial.bomLabelsEnabled);
  const [assemblyTick, setAssemblyTick] = useState(0);
  const [assemblyMessage, setAssemblyMessage] = useState('');
  const [ghostEnabled, setGhostEnabled] = useState(initial.ghostEnabled);
  const [trajectoryEnabled, setTrajectoryEnabled] = useState(initial.trajectoryEnabled);
  const [playing, setPlaying] = useState(false);
  const [presetId, setPresetId] = useState('neutral');
  const [motionMessage, setMotionMessage] = useState('');
  const [savedPoseAvailable, setSavedPoseAvailable] = useState(false);
  const [search, setSearch] = useState('');
  const [viewpointAvailable, setViewpointAvailable] = useState(false);
  const liveStateRef = useRef({ projection, selectedComponentId, hidden, isolated, transparent, wireframe, jointValues, selectedJointId, ghostEnabled, trajectoryEnabled, explosionFactor, assemblyPosition, bomLabelsEnabled });
  liveStateRef.current = { projection, selectedComponentId, hidden, isolated, transparent, wireframe, jointValues, selectedJointId, ghostEnabled, trajectoryEnabled, explosionFactor, assemblyPosition, bomLabelsEnabled };

  const captureViewState = (): Model3DViewState => {
    const env = envRef.current;
    const current = liveStateRef.current;
    return {
      projection: current.projection,
      selectedComponentId: current.selectedComponentId,
      hiddenComponentIds: [...current.hidden],
      isolatedComponentId: current.isolated,
      transparent: current.transparent,
      wireframe: current.wireframe,
      jointValues: current.jointValues,
      selectedJointId: current.selectedJointId,
      ghostEnabled: current.ghostEnabled,
      trajectoryEnabled: current.trajectoryEnabled,
      explosionFactor: current.explosionFactor,
      assemblyPosition: current.assemblyPosition,
      bomLabelsEnabled: current.bomLabelsEnabled,
      cameraPosition: env ? env.activeCamera.position.toArray() as [number, number, number] : undefined,
      cameraTarget: env ? env.controls.target.toArray() as [number, number, number] : undefined,
      cameraZoom: env?.activeCamera.zoom,
    };
  };

  useEffect(() => {
    context.saveViewState(captureViewState());
    const env = envRef.current;
    if (env?.modelRoot) applyDisplayState(env.modelRoot, env.bodies, { hiddenComponentIds: [...hidden], isolatedComponentId: isolated, transparent, wireframe });
  }, [hidden, isolated, transparent, wireframe, selectedComponentId, projection, jointValues, selectedJointId, ghostEnabled, trajectoryEnabled, explosionFactor, assemblyPosition, bomLabelsEnabled]);

  useEffect(() => {
    const componentId = componentIdForElement(context.selected, context.query);
    if (componentId && componentId !== selectedComponentId) setSelectedComponentId(componentId);
    const bodyId = manifest?.components.find((item) => item.componentId === componentId)?.bodyId;
    if (bodyId) setSelectedBodyId(bodyId);
  }, [context.selectedId, context.query, manifest]);

  useEffect(() => {
    const env = envRef.current;
    if (!env) return;
    selectObject(env, selectedBodyId && selectedBodyId !== manifest?.rootBodyId ? env.bodies.get(selectedBodyId) : undefined);
  }, [selectedBodyId, bodyEntries, manifest]);

  useEffect(() => {
    const host = hostRef.current;
    if (!host) return;
    const controller = new AbortController();
    let disposed = false;
    const scene = new THREE.Scene();
    scene.background = new THREE.Color(0xedf2f5);
    const renderer = new THREE.WebGLRenderer({ antialias: true, preserveDrawingBuffer: true });
    renderer.setPixelRatio(Math.min(devicePixelRatio, 2));
    renderer.outputColorSpace = THREE.SRGBColorSpace;
    renderer.toneMapping = THREE.ACESFilmicToneMapping;
    renderer.toneMappingExposure = 1.08;
    renderer.shadowMap.enabled = true;
    renderer.shadowMap.type = THREE.PCFSoftShadowMap;
    host.replaceChildren(renderer.domElement);
    const perspective = new THREE.PerspectiveCamera(38, 1, 0.001, 100);
    const orthographic = new THREE.OrthographicCamera(-0.25, 0.25, 0.25, -0.25, 0.001, 100);
    const activeCamera = projection === 'orthographic' ? orthographic : perspective;
    activeCamera.position.set(0.45, 0.34, 0.5);
    const controls = new OrbitControls(activeCamera, renderer.domElement);
    controls.enableDamping = true; controls.screenSpacePanning = true;
    scene.add(new THREE.HemisphereLight(0xf7fbff, 0x52606b, 1.05));
    const key = new THREE.DirectionalLight(0xffffff, 2.35);
    key.position.set(2.2, 3.4, 2.8); key.castShadow = true;
    key.shadow.mapSize.set(2048, 2048); key.shadow.bias = -0.00015; key.shadow.normalBias = 0.015;
    key.shadow.camera.near = .1; key.shadow.camera.far = 8;
    key.shadow.camera.left = -1.2; key.shadow.camera.right = 1.2; key.shadow.camera.top = 1.2; key.shadow.camera.bottom = -1.2;
    scene.add(key);
    const fill = new THREE.DirectionalLight(0xbfd8ee, .7); fill.position.set(-2.4, 1.2, 1.6); scene.add(fill);
    const rim = new THREE.DirectionalLight(0xfff1dd, .5); rim.position.set(.2, 2.2, -3); scene.add(rim);
    const grid = new THREE.GridHelper(1.5, 30, 0x9baab3, 0xd5dde2); scene.add(grid);
    const floor = new THREE.Mesh(new THREE.PlaneGeometry(4, 4), new THREE.ShadowMaterial({ color: 0x34424f, opacity: .16 }));
    floor.rotation.x = -Math.PI / 2; floor.receiveShadow = true; floor.renderOrder = -1; scene.add(floor);
    const env: ViewerEnvironment = { scene, renderer, perspective, orthographic, activeCamera, controls, components: new Map(), bodies: new Map(), trajectoryPoints: [], collisionProxies: [], collisionHelpers: [], selectionMeshes: [], floor, grid, frame: 0 };
    envRef.current = env;
    const resize = () => resizeViewer(env, host);
    const observer = new ResizeObserver(resize); observer.observe(host); resize();
    const render = () => { env.frame = requestAnimationFrame(render); controls.update(); renderer.render(scene, env.activeCamera); };
    render();
    const saveCamera = () => context.saveViewState(captureViewState());
    controls.addEventListener('end', saveCamera);
    const pick = (event: MouseEvent) => {
      if (!env.modelRoot) return;
      const bounds = renderer.domElement.getBoundingClientRect();
      const pointer = new THREE.Vector2((event.clientX - bounds.left) / bounds.width * 2 - 1, -(event.clientY - bounds.top) / bounds.height * 2 + 1);
      const hits = new THREE.Raycaster(); hits.setFromCamera(pointer, env.activeCamera);
      const hit = hits.intersectObject(env.modelRoot, true).find((item) => item.object.visible);
      const bodyId = objectIdFromObject(hit?.object ?? null, env.bodies);
      if (!bodyId) return;
      setSelectedBodyId(bodyId);
    };
    renderer.domElement.addEventListener('click', pick);

    const load = async () => {
      setStatus({ phase: 'loading', message: '正在加载三维模型…', progress: 0 });
      try {
        const result = localFiles?.length
          ? await loadLocalFiles(localFiles, (loaded, total) => setStatus({ phase: 'loading', message: '正在加载本地模型…', progress: total ? loaded / total : undefined }))
          : resolved
            ? await loadRegistered(resolved.registration.manifestUrl, controller.signal, (loaded, total) => setStatus({ phase: 'loading', message: '正在加载模型网格…', progress: total ? loaded / total : undefined }))
            : undefined;
        if (!result) throw new Error('当前元素没有可解析的 cadRef，也没有匹配项目三维模型注册表');
        if (disposed) { disposeObject3D(result.displayRoot); return; }
        env.displayRoot = result.displayRoot; env.modelRoot = result.modelRoot; scene.add(result.displayRoot);
        env.rig = result.rig;
        prepareMaterials(result.modelRoot);
        alignGroundPlane(env, result.displayRoot);
        env.components = result.manifest ? componentObjects(result.modelRoot, result.manifest) : genericComponents(result.modelRoot);
        env.bodies = result.manifest
          ? new Map(result.manifest.bodies.flatMap((body) => {
              const object = result.modelRoot.getObjectByName(body.nodeName);
              return object ? [[body.bodyId, object] as const] : [];
            }))
          : genericComponents(result.modelRoot);
        env.assemblyRig = result.manifest ? new AssemblyRig(result.manifest, result.modelRoot, env.components) : undefined;
        env.collisionProxies = result.manifest ? collectCollisionProxies(result.manifest, env.components) : [];
        const nextEntries = result.manifest
          ? result.manifest.components.map((item) => ({ componentId: item.componentId, label: item.label, bodyId: item.bodyId, geometryStatus: item.geometryStatus }))
          : [...env.components].map(([componentId]) => ({ componentId, label: componentId }));
        const nextBodies: PhysicalEntry[] = result.manifest
          ? result.manifest.bodies.map((body) => ({
              bodyId: body.bodyId,
              label: body.label,
              parentBodyId: body.parentBodyId,
              componentIds: result.manifest!.components.filter((component) => component.bodyId === body.bodyId).map((component) => component.componentId),
            }))
          : [...env.bodies].map(([bodyId]) => ({ bodyId, label: physicalLabel(bodyId), parentBodyId: undefined, componentIds: [] }));
        const rootBodyId = result.manifest?.rootBodyId ?? nextBodies.find((body) => !body.parentBodyId)?.bodyId;
        setManifest(result.manifest); setEntries(nextEntries); setBodyEntries(nextBodies);
        setExpandedBodies(new Set(nextBodies.filter((body) => body.bodyId === rootBodyId || body.parentBodyId === rootBodyId).map((body) => body.bodyId)));
        setAssemblySequence(result.assemblySequence);
        const initialBodyId = result.manifest?.components.find((item) => item.componentId === selectedComponentId)?.bodyId ?? result.manifest?.rootBodyId ?? nextBodies[0]?.bodyId;
        setSelectedBodyId(initialBodyId);
        if (result.rig) {
          const restored = Object.keys(initial.jointValues).length ? result.rig.setPose(initial.jointValues) : result.rig.getPose();
          const pose = { ...result.rig.getPose(), ...restored };
          setJointValues(pose);
          setSelectedJointId((current) => current && result.rig!.jointIds.includes(current) ? current : result.rig!.jointIds[0]);
        } else {
          setJointValues({}); setSelectedJointId(undefined);
        }
        applyDisplayState(result.modelRoot, env.bodies, { hiddenComponentIds: [...hidden], isolatedComponentId: isolated, transparent, wireframe });
        if (env.assemblyRig && result.assemblySequence && initial.assemblyPosition > 0) {
          applyAssemblyPosition(env.assemblyRig, result.assemblySequence, initial.assemblyPosition);
        } else if (env.assemblyRig && initial.explosionFactor > 0) {
          env.assemblyRig.setExplodeDistance(explosionDistance); env.assemblyRig.setExplode(initial.explosionFactor);
        }
        if (initial.bomLabelsEnabled && result.manifest) createBomLabels(env, result.manifest);
        if (initial.cameraPosition && initial.cameraTarget) restoreCamera(env, initial); else fitViewer(env, result.displayRoot);
        setStatus({ phase: 'ready', message: `${nextBodies.length} 个物理装配节点` });
      } catch (error) {
        if (!disposed && !(error instanceof DOMException && error.name === 'AbortError')) setStatus({ phase: 'error', message: error instanceof Error ? error.message : '模型加载失败' });
      }
    };
    void load();
    return () => {
      disposed = true; controller.abort(); observer.disconnect(); controls.removeEventListener('end', saveCamera); controls.dispose();
      renderer.domElement.removeEventListener('click', pick); cancelAnimationFrame(env.frame); if (env.motionFrame) cancelAnimationFrame(env.motionFrame); if (env.assemblyFrame) cancelAnimationFrame(env.assemblyFrame);
      clearGhost(env); clearTrajectory(env); clearCollisionHighlights(env); clearBomLabels(env);
      if (env.displayRoot) disposeObject3D(env.displayRoot); renderer.dispose(); renderer.forceContextLoss(); host.replaceChildren();
      env.floor.geometry.dispose();
      const floorMaterials = Array.isArray(env.floor.material) ? env.floor.material : [env.floor.material];
      floorMaterials.forEach((material) => material.dispose());
      env.grid.geometry.dispose();
      const gridMaterials = Array.isArray(env.grid.material) ? env.grid.material : [env.grid.material];
      gridMaterials.forEach((material) => material.dispose());
      if (envRef.current === env) envRef.current = undefined;
    };
  }, [resolved?.registration.manifestUrl, localFiles]);

  useEffect(() => {
    const env = envRef.current;
    if (!env || env.activeCamera === (projection === 'orthographic' ? env.orthographic : env.perspective)) return;
    const previous = env.activeCamera; const next = projection === 'orthographic' ? env.orthographic : env.perspective;
    next.position.copy(previous.position); next.quaternion.copy(previous.quaternion); next.zoom = previous.zoom; next.updateProjectionMatrix();
    env.activeCamera = next; env.controls.object = next; env.controls.update();
  }, [projection]);

  const chooseComponent = (componentId: string) => {
    setSelectedComponentId(componentId);
    const bodyId = manifest?.components.find((component) => component.componentId === componentId)?.bodyId;
    if (bodyId) setSelectedBodyId(bodyId);
    if (manifest?.joints.some((joint) => joint.jointId === componentId)) setSelectedJointId(componentId);
    const sysml = sysmlByComponent.get(componentId); if (sysml) context.selectInView(sysml.id);
  };
  const chooseBody = (bodyId: string) => {
    setSelectedBodyId(bodyId);
    const component = manifest?.components.find((item) => item.nodeName === manifest.bodies.find((body) => body.bodyId === bodyId)?.nodeName)
      ?? manifest?.components.find((item) => item.bodyId === bodyId);
    if (component) setSelectedComponentId(component.componentId);
  };
  const selectedEntry = entries.find((item) => item.componentId === selectedComponentId);
  const selectedBodyEntry = bodyEntries.find((item) => item.bodyId === selectedBodyId);
  const physicalRows = useMemo(() => flattenPhysicalTree(bodyEntries, expandedBodies, search), [bodyEntries, expandedBodies, search]);
  const viewpointKey = `aidc-model3d-viewpoint:${manifest?.modelId ?? 'local'}`;
  const poseKey = `aidc-model3d-pose:${manifest?.modelId ?? 'local'}`;
  const presets = useMemo(() => manifest ? standardPosePresets(manifest) : [], [manifest]);
  const saveViewpoint = () => { localStorage.setItem(viewpointKey, JSON.stringify(captureViewState())); setViewpointAvailable(true); };
  const restoreViewpoint = () => { const raw = localStorage.getItem(viewpointKey); if (!raw || !envRef.current) return; const state = parseModel3DViewState(JSON.parse(raw)); restoreCamera(envRef.current, state); setProjection(state.projection); setHidden(new Set(state.hiddenComponentIds)); setIsolated(state.isolatedComponentId); setTransparent(state.transparent); setWireframe(state.wireframe); setSelectedComponentId(state.selectedComponentId); };

  const applyJointValue = (jointId: string, requestedValue: number) => {
    const env = envRef.current; const joint = manifest?.joints.find((item) => item.jointId === jointId);
    if (!env?.rig || !joint || !Number.isFinite(requestedValue)) return;
    if (env.motionFrame) { cancelAnimationFrame(env.motionFrame); env.motionFrame = undefined; setPlaying(false); }
    const applied = env.rig.setJoint(jointId, requestedValue);
    setJointValues(env.rig.getPose()); setSelectedJointId(jointId); chooseComponent(jointId);
    const limit = isAtJointLimit(joint, applied);
    setMotionMessage(limit ? `${jointLabel(jointId)}已达到${limit === 'lower' ? '下' : '上'}限` : '');
    if (trajectoryEnabled) appendTrajectoryPoint(env, jointId);
  };

  const animateToPose = (target: JointPose, label: string) => {
    const env = envRef.current;
    if (!env?.rig || !manifest) return;
    if (env.motionFrame) cancelAnimationFrame(env.motionFrame);
    if (ghostEnabled) createGhost(env); else clearGhost(env);
    clearTrajectory(env);
    const from = env.rig.getPose();
    const bounded = Object.fromEntries(manifest.joints.map((joint) => [joint.jointId, target[joint.jointId] ?? from[joint.jointId] ?? joint.neutralValue]));
    const duration = motionDuration(manifest, from, bounded);
    const started = performance.now(); setPlaying(true); setMotionMessage(`${label} · ${Math.round(duration)} ms`);
    const step = (now: number) => {
      const progress = Math.min(1, (now - started) / duration);
      env.rig!.setPose(interpolatePose(from, bounded, progress));
      setJointValues(env.rig!.getPose());
      if (trajectoryEnabled && selectedJointId) appendTrajectoryPoint(env, selectedJointId);
      if (progress < 1) env.motionFrame = requestAnimationFrame(step);
      else { env.motionFrame = undefined; setPlaying(false); setMotionMessage(`${label}已完成`); }
    };
    env.motionFrame = requestAnimationFrame(step);
  };

  const resetPose = () => {
    const preset = presets.find((item) => item.id === 'neutral'); if (preset) animateToPose(preset.pose, preset.label);
  };
  const savePose = () => {
    const pose = envRef.current?.rig?.getPose(); if (!pose) return;
    localStorage.setItem(poseKey, JSON.stringify({ name: '已保存姿态', pose })); setSavedPoseAvailable(true); setMotionMessage('当前姿态已保存');
  };
  const playSavedPose = () => {
    const raw = localStorage.getItem(poseKey); if (!raw) return;
    try { const saved = JSON.parse(raw) as { name?: string; pose?: JointPose }; if (saved.pose) animateToPose(saved.pose, saved.name ?? '已保存姿态'); } catch { setMotionMessage('保存的姿态数据无效'); }
  };

  useEffect(() => { if (!ghostEnabled && envRef.current) clearGhost(envRef.current); }, [ghostEnabled]);
  useEffect(() => { if (!trajectoryEnabled && envRef.current) clearTrajectory(envRef.current); }, [trajectoryEnabled]);
  useEffect(() => {
    const env = envRef.current;
    if (!env || !manifest || !collisionEnabled) { if (env) clearCollisionHighlights(env); return; }
    env.scene.updateMatrixWorld(true);
    refreshCollisionProxies(env.collisionProxies, env.components);
    const next = detectInterferences(env.collisionProxies, manifest, jointValues);
    setCollisionResults((current) => mergeExactResults(next, current));
  }, [jointValues, manifest, collisionEnabled, assemblyTick]);
  useEffect(() => {
    const env = envRef.current; if (!env) return;
    if (!collisionPanel || !selectedPairId) { clearCollisionHighlights(env); return; }
    const visible = collisionResults.filter((item) =>
      (item.status === 'WARNING' || item.status === 'CONFIRMED') && item.pairId === selectedPairId,
    );
    renderCollisionHighlights(env, visible);
  }, [collisionResults, selectedPairId, collisionPanel]);

  const filteredCollisionResults = collisionResults.filter((item) => collisionFilter === 'all' || item.status === 'WARNING' || item.status === 'CONFIRMED' || item.status === 'UNVERIFIED');
  const activeCollisionCount = collisionResults.filter((item) => item.status === 'WARNING' || item.status === 'CONFIRMED').length;
  const selectCollisionPair = (item: InterferencePairResult) => {
    setSelectedPairId(item.pairId ?? `${item.componentA}::${item.componentB}`); setSelectedComponentId(item.componentA);
    const env = envRef.current; if (env) fitViewerToComponents(env, [item.componentA, item.componentB]);
  };
  const checkExact = async (item: InterferencePairResult) => {
    const env = envRef.current; if (!env || !manifest) return;
    const componentA = manifest.components.find((entry) => entry.componentId === item.componentA);
    const componentB = manifest.components.find((entry) => entry.componentId === item.componentB);
    const objectA = env.components.get(item.componentA); const objectB = env.components.get(item.componentB);
    if (!componentA || !componentB || !objectA || !objectB) return;
    objectA.updateWorldMatrix(true, false); objectB.updateWorldMatrix(true, false);
    setExactChecking(true); setExactMessage('正在调用本地 FreeCAD/OpenCascade…');
    try {
      const result = await exactCheck({
        schemaVersion: INTERFERENCE_REPORT_SCHEMA_VERSION, modelId: manifest.modelId, modelRevision: manifest.revision,
        cadSha256: manifest.source.cadSha256, tolerance: manifest.collision?.tolerance ?? 0,
        componentA: { componentId: item.componentA, sourceObject: componentA.sourceObject, matrixWorld: objectA.matrixWorld.toArray() },
        componentB: { componentId: item.componentB, sourceObject: componentB.sourceObject, matrixWorld: objectB.matrixWorld.toArray() },
        pose: { ...jointValues },
      });
      setCollisionResults((current) => current.map((entry) => entry.pairId === item.pairId ? result : entry));
      setExactMessage(result.message ?? '精确校核完成');
    } catch (error) {
      setCollisionResults((current) => current.map((entry) => entry.pairId === item.pairId ? { ...entry, status: 'UNVERIFIED', message: '本地精确校核服务未启动', checkedAt: new Date().toISOString() } : entry));
      setExactMessage(error instanceof Error ? `${error.message}；请运行 exact-check/run.ps1` : '精确校核服务不可用');
    } finally { setExactChecking(false); }
  };
  const assemblyStepCount = assemblySequence?.steps.length ?? 0;
  const currentAssemblyStepIndex = assemblyStepCount ? Math.min(assemblyStepCount - 1, Math.max(0, Math.ceil(assemblyPosition) - 1)) : -1;
  const currentAssemblyStep = currentAssemblyStepIndex >= 0 ? assemblySequence?.steps[currentAssemblyStepIndex] : undefined;
  const setExplodeValue = (factor: number) => {
    const env = envRef.current; if (!env?.assemblyRig) return;
    if (env.assemblyFrame) { cancelAnimationFrame(env.assemblyFrame); env.assemblyFrame = undefined; setAssemblyPlaying(false); }
    env.assemblyRig.setExplodeDistance(explosionDistance); env.assemblyRig.setExplode(factor);
    setExplosionFactor(factor); setAssemblyPosition(0); setAssemblyMessage(factor ? `自动爆炸 ${Math.round(factor * 100)}%` : '已精确归位'); setAssemblyTick((value) => value + 1);
  };
  const setSequenceValue = (requested: number) => {
    const env = envRef.current; if (!env?.assemblyRig || !assemblySequence) return;
    const value = THREE.MathUtils.clamp(requested, 0, assemblySequence.steps.length);
    applyAssemblyPosition(env.assemblyRig, assemblySequence, value);
    setAssemblyPosition(value); setExplosionFactor(0); setAssemblyTick((tick) => tick + 1);
  };
  const playAssembly = () => {
    const env = envRef.current; if (!env?.assemblyRig || !assemblySequence?.steps.length) return;
    if (env.assemblyFrame) cancelAnimationFrame(env.assemblyFrame);
    if (ghostEnabled) createGhost(env); else clearGhost(env);
    const from = assemblyPosition; const to = assemblyDirection === 'disassembly' ? assemblySequence.steps.length : 0;
    if (Math.abs(from - to) < 1e-6) { setSequenceValue(assemblyDirection === 'disassembly' ? 0 : assemblySequence.steps.length); return; }
    const duration = Math.max(700, Math.abs(to - from) * 850); const started = performance.now(); setAssemblyPlaying(true);
    setAssemblyMessage(assemblyDirection === 'disassembly' ? '正在演示拆卸路径' : '正在演示装配路径');
    const step = (now: number) => {
      const progress = Math.min(1, (now - started) / duration);
      const eased = progress < .5 ? 2 * progress * progress : 1 - Math.pow(-2 * progress + 2, 2) / 2;
      const value = THREE.MathUtils.lerp(from, to, eased);
      applyAssemblyPosition(env.assemblyRig!, assemblySequence, value);
      setAssemblyPosition(value); setAssemblyTick((tick) => tick + 1);
      if (progress < 1) env.assemblyFrame = requestAnimationFrame(step);
      else { env.assemblyFrame = undefined; setAssemblyPlaying(false); setAssemblyMessage(assemblyDirection === 'disassembly' ? '拆卸演示完成' : '装配演示完成'); }
    };
    env.assemblyFrame = requestAnimationFrame(step);
  };
  const updateExplodeDirection = (axis: 0 | 1 | 2, value: number) => {
    const rig = envRef.current?.assemblyRig; if (!rig || !selectedComponentId || !Number.isFinite(value)) return;
    const direction = rig.getDirection(selectedComponentId); if (!direction) return;
    direction[axis] = value; rig.setDirection(selectedComponentId, direction); rig.setExplodeDistance(explosionDistance); rig.setExplode(explosionFactor);
    setAssemblyTick((tick) => tick + 1);
  };
  const selectedExplodeDirection = selectedComponentId ? envRef.current?.assemblyRig?.getDirection(selectedComponentId) : undefined;

  useEffect(() => {
    const env = envRef.current; if (!env || !manifest) return;
    if (bomLabelsEnabled) createBomLabels(env, manifest); else clearBomLabels(env);
  }, [bomLabelsEnabled, manifest]);

  return <div className="model3d-view">
    <div className="model3d-toolbar">
      <div className="model3d-status"><Box size={15} /><span><strong>{manifest?.name ?? (localFiles ? '本地三维模型' : '三维模型')}</strong><small>{status.message}</small></span>{status.phase === 'loading' && <RefreshCw size={14} className="spin" />}</div>
      <div className="model3d-tools">
        <button onClick={() => setStandardView(envRef.current, 'iso')} title="等轴测"><Focus size={14} />等轴测</button>
        <button onClick={() => setStandardView(envRef.current, 'front')}>前</button><button onClick={() => setStandardView(envRef.current, 'left')}>左</button><button onClick={() => setStandardView(envRef.current, 'top')}>顶</button>
        <button onClick={() => envRef.current?.displayRoot && fitViewer(envRef.current, envRef.current.displayRoot)} title="适应窗口"><Maximize2 size={14} /></button>
        <button className={projection === 'orthographic' ? 'active' : ''} onClick={() => setProjection((value) => value === 'perspective' ? 'orthographic' : 'perspective')}>{projection === 'perspective' ? '透视' : '正交'}</button>
        <button className={transparent ? 'active' : ''} onClick={() => setTransparent((value) => !value)}>透明</button>
        <button className={wireframe ? 'active' : ''} onClick={() => setWireframe((value) => !value)}>线框</button>
        <button className={motionPanel ? 'active' : ''} disabled={!manifest?.joints.length} onClick={() => { setMotionPanel((value) => !value); setCollisionPanel(false); setAssemblyPanel(false); }}><Activity size={14} />运动学</button>
        <button className={collisionPanel ? 'active' : ''} disabled={!manifest?.collision} onClick={() => { setCollisionPanel((value) => !value); setMotionPanel(false); setAssemblyPanel(false); }}><ShieldAlert size={14} />干涉 {activeCollisionCount}</button>
        <button className={assemblyPanel ? 'active' : ''} disabled={!assemblySequence} onClick={() => { setAssemblyPanel((value) => !value); setMotionPanel(false); setCollisionPanel(false); }}><Wrench size={14} />装配</button>
        <button onClick={saveViewpoint} title="保存当前视点"><Save size={14} /></button>
        <button disabled={!viewpointAvailable && !localStorage.getItem(viewpointKey)} onClick={restoreViewpoint}>恢复视点</button>
        <button onClick={() => downloadScreenshot(envRef.current)} title="保存截图"><Camera size={14} /></button>
        <button onClick={() => fileRef.current?.click()}><Upload size={14} />打开模型</button>
        <input ref={fileRef} hidden multiple type="file" accept=".json,.glb,.gltf,model/gltf-binary,model/gltf+json" onChange={(event) => { const files = [...(event.target.files ?? [])]; if (files.length) setLocalFiles(files); event.target.value = ''; }} />
      </div>
    </div>
    <div className={`model3d-main ${motionPanel || collisionPanel || assemblyPanel ? 'motion-mode' : ''}`}>
      <aside className="model3d-tree"><div className="model3d-panel-head"><strong>物理结构</strong><span>{bodyEntries.length}</span></div><input value={search} onChange={(event) => setSearch(event.target.value)} placeholder="搜索装配或刚体…" /><div className="model3d-component-list">{physicalRows.map((entry) => <div key={entry.bodyId} className={entry.bodyId === selectedBodyId ? 'selected' : ''} style={{ paddingLeft: entry.depth * 12 }}><button className="model3d-tree-toggle" disabled={!entry.hasChildren} title={expandedBodies.has(entry.bodyId) ? '折叠' : '展开'} onClick={() => setExpandedBodies((current) => { const next = new Set(current); next.has(entry.bodyId) ? next.delete(entry.bodyId) : next.add(entry.bodyId); return next; })}>{entry.hasChildren ? expandedBodies.has(entry.bodyId) ? <ChevronDown size={12} /> : <ChevronRight size={12} /> : <span />}</button><button className="model3d-component" onClick={() => chooseBody(entry.bodyId)}><Box size={13} /><span><strong>{entry.label}</strong><small>{entry.bodyId}</small></span></button><button className="model3d-eye" title={hidden.has(entry.bodyId) ? '显示' : '隐藏'} onClick={() => setHidden((current) => { const next = new Set(current); next.has(entry.bodyId) ? next.delete(entry.bodyId) : next.add(entry.bodyId); return next; })}>{hidden.has(entry.bodyId) ? <EyeOff size={13} /> : <Eye size={13} />}</button></div>)}</div></aside>
      <div className="model3d-canvas-wrap"><div ref={hostRef} className="model3d-canvas" />{status.phase === 'loading' && <div className="model3d-loading"><RefreshCw className="spin" /><strong>{status.message}</strong>{status.progress != null && <><progress max="1" value={status.progress} /><span>{Math.round(status.progress * 100)}%</span></>}</div>}{status.phase === 'error' && <div className="model3d-error"><AlertTriangle /><strong>无法打开三维模型</strong><span>{status.message}</span><button onClick={() => fileRef.current?.click()}>选择 GLB、glTF 或模型包文件</button></div>}</div>
      <aside className={`model3d-properties ${motionPanel || collisionPanel || assemblyPanel ? 'motion-open' : ''}`}>
        <div className="model3d-panel-tabs"><button className={!motionPanel && !collisionPanel && !assemblyPanel ? 'active' : ''} onClick={() => { setMotionPanel(false); setCollisionPanel(false); setAssemblyPanel(false); }}>部件</button><button className={motionPanel ? 'active' : ''} disabled={!manifest?.joints.length} onClick={() => { setMotionPanel(true); setCollisionPanel(false); setAssemblyPanel(false); }}>运动 {manifest?.joints.length ?? 0}</button><button className={collisionPanel ? 'active' : ''} disabled={!manifest?.collision} onClick={() => { setCollisionPanel(true); setMotionPanel(false); setAssemblyPanel(false); }}>干涉 {activeCollisionCount}</button><button className={assemblyPanel ? 'active' : ''} disabled={!assemblySequence} onClick={() => { setAssemblyPanel(true); setMotionPanel(false); setCollisionPanel(false); }}>装配 {assemblyStepCount}</button></div>
        {assemblyPanel && manifest && assemblySequence ? <div className="model3d-assembly-panel">
          <section className="model3d-explode-controls"><header><span><Move3d size={14} />自动爆炸</span><strong>{Math.round(explosionFactor * 100)}%</strong></header><input aria-label="爆炸程度" type="range" min="0" max="1" step="0.01" value={explosionFactor} disabled={assemblyPlaying} onChange={(event) => setExplodeValue(Number(event.target.value))} /><label>最大距离<input aria-label="爆炸最大距离" type="number" min="20" max="300" step="5" value={Math.round(explosionDistance * 1000)} onChange={(event) => { const distance = THREE.MathUtils.clamp(Number(event.target.value) / 1000, .02, .3); setExplosionDistance(distance); envRef.current?.assemblyRig?.setExplodeDistance(distance); if (explosionFactor) envRef.current?.assemblyRig?.setExplode(explosionFactor); setAssemblyTick((tick) => tick + 1); }} /><span>mm</span></label><button onClick={() => setExplodeValue(0)}><RotateCcw size={12} />精确归位</button></section>
          <section className="model3d-assembly-options"><button className={bomLabelsEnabled ? 'active' : ''} onClick={() => setBomLabelsEnabled((value) => !value)}><Tags size={12} />BOM 标注</button><button className={ghostEnabled ? 'active' : ''} onClick={() => setGhostEnabled((value) => !value)}>路径残影</button><button onClick={() => downloadAssemblyReview(manifest, assemblySequence, assemblyPosition, collisionResults)}><Download size={12} />审查记录</button></section>
          {selectedExplodeDirection && <section className="model3d-direction-editor"><strong>人工爆炸方向 · {selectedComponentId}</strong><div>{(['X','Y','Z'] as const).map((axis, index) => <label key={axis}>{axis}<input type="number" step="0.1" value={Number(selectedExplodeDirection[index].toFixed(2))} onChange={(event) => updateExplodeDirection(index as 0 | 1 | 2, Number(event.target.value))} /></label>)}</div><small>选择模型树中的可爆炸部件后编辑，向量自动归一化。</small></section>}
          <section className="model3d-sequence-controls"><div><select aria-label="装配播放方向" value={assemblyDirection} onChange={(event) => setAssemblyDirection(event.target.value as 'disassembly' | 'assembly')}><option value="disassembly">拆卸顺序</option><option value="assembly">装配顺序</option></select><button disabled={assemblyPlaying || assemblyPosition <= 0} onClick={() => setSequenceValue(Math.ceil(assemblyPosition) - 1)}><ChevronLeft size={13} /></button><button onClick={assemblyPlaying ? () => { const env = envRef.current; if (env?.assemblyFrame) cancelAnimationFrame(env.assemblyFrame); if (env) env.assemblyFrame = undefined; setAssemblyPlaying(false); setAssemblyMessage('已暂停'); } : playAssembly}>{assemblyPlaying ? <Pause size={13} /> : <Play size={13} />}</button><button disabled={assemblyPlaying || assemblyPosition >= assemblyStepCount} onClick={() => setSequenceValue(Math.floor(assemblyPosition) + 1)}><ChevronRight size={13} /></button></div><input aria-label="装配时间线" type="range" min="0" max={assemblyStepCount} step="0.01" value={assemblyPosition} disabled={assemblyPlaying} onChange={(event) => setSequenceValue(Number(event.target.value))} /><small>步骤 {assemblyPosition.toFixed(2)} / {assemblyStepCount} · 当前 {activeCollisionCount} 项实时预警</small></section>
          {assemblyMessage && <div className="model3d-motion-message">{assemblyPlaying && <RefreshCw size={11} className="spin" />}{assemblyMessage}</div>}
          {currentAssemblyStep && <section className="model3d-current-step"><header><span>{pathStatusLabel(currentAssemblyStep.pathStatus)}</span><strong>{currentAssemblyStep.label}</strong></header><p>{currentAssemblyStep.description}</p><dl><div><dt>部件</dt><dd>{currentAssemblyStep.componentIds.join('、')}</dd></div><div><dt>依赖</dt><dd>{currentAssemblyStep.dependsOn.join('、') || '无'}</dd></div><div><dt>工具</dt><dd>{currentAssemblyStep.tool?.label ?? '未指定'}</dd></div><div><dt>工具方向</dt><dd>{currentAssemblyStep.tool ? vectorLabel(currentAssemblyStep.tool.direction) : '—'}</dd></div></dl></section>}
          <div className="model3d-step-list">{assemblySequence.steps.map((step, index) => <button key={step.stepId} className={index === currentAssemblyStepIndex ? 'active' : ''} onClick={() => setSequenceValue(index + 1)}><span>{index + 1}</span><strong>{step.label}</strong><small>{pathStatusLabel(step.pathStatus)}</small></button>)}</div>
        </div> : collisionPanel && manifest ? <div className="model3d-collision-panel">
          <div className="model3d-collision-summary"><span className={activeCollisionCount ? 'warning' : 'clear'}>{activeCollisionCount ? <ShieldAlert size={16} /> : <CheckCircle2 size={16} />}<strong>{activeCollisionCount ? `${activeCollisionCount} 项待处理` : '当前姿态未发现干涉'}</strong></span><small>实时结果为方向包围盒预警，精确结论由 FreeCAD/OpenCascade 给出。</small></div>
          <div className="model3d-collision-controls"><button className={collisionEnabled ? 'active' : ''} onClick={() => setCollisionEnabled((value) => !value)}>{collisionEnabled ? '实时检测中' : '已暂停'}</button><select value={collisionFilter} onChange={(event) => setCollisionFilter(event.target.value as 'active' | 'all')}><option value="active">待处理</option><option value="all">全部结果</option></select></div>
          {exactMessage && <div className="model3d-exact-message">{exactChecking && <RefreshCw size={11} className="spin" />}{exactMessage}</div>}
          <div className="model3d-collision-list">{filteredCollisionResults.map((item) => <article key={item.pairId} className={`${item.status.toLowerCase()} ${item.pairId === selectedPairId ? 'selected' : ''}`} onClick={() => selectCollisionPair(item)}>
            <header><span>{collisionStatusLabel(item.status)}</span><code>{item.precision === 'BREP_EXACT' ? 'B-Rep 精确' : '实时预警'}</code></header>
            <strong>{item.componentA}</strong><i>×</i><strong>{item.componentB}</strong>
            <dl><div><dt>最小间隙</dt><dd>{formatDistance(item.minimumDistance)}</dd></div><div><dt>相交体积</dt><dd>{formatVolume(item.commonVolume)}</dd></div></dl>
            <p>{item.message}</p>
            <footer><button onClick={(event) => { event.stopPropagation(); selectCollisionPair(item); }}><Crosshair size={11} />定位</button><button disabled={!item.pose || playing} onClick={(event) => { event.stopPropagation(); if (item.pose) animateToPose(item.pose, '预警姿态'); }}>恢复姿态</button><button disabled={exactChecking || item.status === 'ALLOWED_CONTACT'} onClick={(event) => { event.stopPropagation(); void checkExact(item); }}>精确校核</button></footer>
          </article>)}{!filteredCollisionResults.length && <div className="model3d-no-selection">当前筛选条件下没有干涉记录</div>}</div>
        </div> : motionPanel && manifest ? <div className="model3d-motion-panel">
          <div className="model3d-pose-controls">
            <label>姿态预设<select value={presetId} onChange={(event) => setPresetId(event.target.value)}>{presets.map((preset) => <option key={preset.id} value={preset.id}>{preset.label}</option>)}</select></label>
            <button disabled={playing} onClick={() => { const preset = presets.find((item) => item.id === presetId); if (preset) animateToPose(preset.pose, preset.label); }}><Play size={13} />播放预设</button>
            <button disabled={playing} onClick={resetPose}><RotateCcw size={13} />中性复位</button>
            <button onClick={savePose}><Save size={13} />保存姿态</button>
            <button disabled={playing || (!savedPoseAvailable && !localStorage.getItem(poseKey))} onClick={playSavedPose}><Play size={13} />播放保存</button>
          </div>
          <div className="model3d-motion-options"><button className={ghostEnabled ? 'active' : ''} onClick={() => setGhostEnabled((value) => !value)}>残影</button><button className={trajectoryEnabled ? 'active' : ''} onClick={() => setTrajectoryEnabled((value) => !value)}>轨迹</button></div>
          {motionMessage && <div className="model3d-motion-message">{playing && <RefreshCw size={11} className="spin" />}{motionMessage}</div>}
          <div className="model3d-joint-list">{manifest.joints.map((joint) => {
            const value = jointValues[joint.jointId] ?? joint.neutralValue;
            const degrees = THREE.MathUtils.radToDeg(value);
            const lower = THREE.MathUtils.radToDeg(joint.limit?.lower ?? -Math.PI);
            const upper = THREE.MathUtils.radToDeg(joint.limit?.upper ?? Math.PI);
            const atLimit = isAtJointLimit(joint, value);
            return <div key={joint.jointId} className={`model3d-joint ${joint.jointId === selectedJointId ? 'selected' : ''} ${atLimit ? 'at-limit' : ''}`} onClick={() => { setSelectedJointId(joint.jointId); chooseComponent(joint.jointId); }}>
              <div><strong>{jointLabel(joint.jointId)}</strong><code>{joint.jointId}</code>{atLimit && <span>{atLimit === 'lower' ? '下限' : '上限'}</span>}</div>
              <input aria-label={`${jointLabel(joint.jointId)}滑块`} type="range" min={lower} max={upper} step="0.1" disabled={joint.type === 'fixed' || playing} value={degrees} onClick={(event) => event.stopPropagation()} onChange={(event) => applyJointValue(joint.jointId, THREE.MathUtils.degToRad(Number(event.target.value)))} />
              <label><input aria-label={`${jointLabel(joint.jointId)}角度`} type="number" min={lower} max={upper} step="0.1" disabled={joint.type === 'fixed' || playing} value={Number(degrees.toFixed(1))} onClick={(event) => event.stopPropagation()} onChange={(event) => applyJointValue(joint.jointId, THREE.MathUtils.degToRad(Number(event.target.value)))} /><span>°</span></label>
              <small>{lower.toFixed(1)}° — {upper.toFixed(1)}° · {joint.type}</small>
            </div>;
          })}</div>
        </div> : selectedBodyEntry ? <><div className="model3d-selected-title"><Box /><strong>{selectedBodyEntry.label}</strong><code>{selectedBodyEntry.bodyId}</code></div><dl><div><dt>父装配</dt><dd>{selectedBodyEntry.parentBodyId ?? '根装配'}</dd></div><div><dt>子装配</dt><dd>{bodyEntries.filter((item) => item.parentBodyId === selectedBodyEntry.bodyId).length}</dd></div><div><dt>关联工程对象</dt><dd>{selectedBodyEntry.componentIds.length ? selectedBodyEntry.componentIds.join('、') : '无'}</dd></div>{selectedEntry && <div><dt>几何状态</dt><dd>{selectedEntry.geometryStatus ?? '本地模型'}</dd></div>}</dl><div className="model3d-property-actions"><button onClick={() => setIsolated((value) => value === selectedBodyEntry.bodyId ? undefined : selectedBodyEntry.bodyId)}>{isolated === selectedBodyEntry.bodyId ? '退出隔离' : '隔离装配'}</button><button onClick={() => { setHidden(new Set()); setIsolated(undefined); }}>全部显示</button><button onClick={() => envRef.current?.bodies.get(selectedBodyEntry.bodyId) && fitViewer(envRef.current, envRef.current.bodies.get(selectedBodyEntry.bodyId)!)}>定位装配</button></div></> : <div className="model3d-no-selection">在物理结构或三维场景中选择装配</div>}
      </aside>
    </div>
  </div>;
}

async function loadRegistered(url: string, signal: AbortSignal, onProgress: (loaded: number, total?: number) => void) {
  const [loaded, assemblySequence] = await Promise.all([
    loadRobotModel(url, { signal, onProgress }),
    fetch(new URL('assembly.sequence.json', new URL(url, window.location.href)), { signal }).then(async (response) => response.ok ? await response.json() as AssemblySequence : undefined).catch(() => undefined),
  ]);
  if (assemblySequence && (assemblySequence.modelId !== loaded.manifest.modelId || assemblySequence.modelRevision !== loaded.manifest.revision)) throw new Error('装配序列与模型 ID 或版本不一致');
  return { displayRoot: loaded.displayRoot, modelRoot: loaded.modelRoot, manifest: loaded.manifest, rig: loaded.rig, assemblySequence };
}

async function loadLocalFiles(files: File[], onProgress: (loaded: number, total?: number) => void) {
  const manifestFile = files.find((file) => file.name.toLowerCase().includes('manifest') && file.name.toLowerCase().endsWith('.json'));
  const assemblyFile = files.find((file) => file.name.toLowerCase().includes('assembly.sequence') && file.name.toLowerCase().endsWith('.json'));
  let manifest: Model3DManifest | undefined;
  let assemblySequence: AssemblySequence | undefined;
  let visual = files.find((file) => /\.(glb|gltf)$/i.test(file.name));
  if (manifestFile) {
    manifest = JSON.parse(await manifestFile.text()) as Model3DManifest;
    if (assemblyFile) assemblySequence = JSON.parse(await assemblyFile.text()) as AssemblySequence;
    const uri = manifest.assets.find((item) => item.role === 'visual')?.uri;
    if (!uri) throw new Error('模型包清单没有 visual 资产');
    const name = uri.split('/').pop(); visual = files.find((file) => file.name === name) ?? visual;
    if (!visual) throw new Error(`请同时选择模型包引用的 ${name}`);
  }
  if (!visual) throw new Error('请选择 .glb、.gltf，或同时选择 manifest JSON 与视觉资产');
  const objectUrls = files.map((file) => ({ file, url: URL.createObjectURL(file) }));
  const urlByName = new Map(objectUrls.flatMap(({ file, url }) => {
    const path = file.webkitRelativePath || file.name;
    return [[file.name, url], [path, url], [path.replace(/\\/g, '/'), url]] as [string, string][];
  }));
  const manager = new THREE.LoadingManager();
  manager.setURLModifier((requestedUrl) => {
    const decoded = decodeURIComponent(requestedUrl).replace(/\\/g, '/');
    const basename = decoded.split('/').pop() ?? decoded;
    return urlByName.get(decoded) ?? urlByName.get(basename) ?? requestedUrl;
  });
  const url = objectUrls.find(({ file }) => file === visual)!.url;
  try {
    const gltf = await new Promise<Awaited<ReturnType<GLTFLoader['loadAsync']>>>((resolve, reject) => new GLTFLoader(manager).load(url, resolve, (event) => onProgress(event.loaded, event.total || undefined), reject));
    const displayRoot = new THREE.Group(); displayRoot.name = 'aidc-local-model-display';
    if (manifest?.coordinateSystem.up === '+Z') displayRoot.rotation.x = -Math.PI / 2;
    displayRoot.add(gltf.scene);
    return { displayRoot, modelRoot: gltf.scene, manifest, rig: manifest ? new RobotRig(manifest, gltf.scene) : undefined, assemblySequence };
  } finally { for (const entry of objectUrls) URL.revokeObjectURL(entry.url); }
}

function genericComponents(root: THREE.Object3D) {
  const result = new Map<string, THREE.Object3D>();
  root.traverse((object) => { if (object.name && (object instanceof THREE.Mesh || object.children.length)) result.set(object.name, object); });
  if (!result.size) result.set('model', root);
  return result;
}

function resizeViewer(env: ViewerEnvironment, host: HTMLElement) {
  const width = Math.max(1, host.clientWidth); const height = Math.max(1, host.clientHeight); const aspect = width / height;
  env.renderer.setSize(width, height, false); env.perspective.aspect = aspect; env.perspective.updateProjectionMatrix();
  const size = 0.4; env.orthographic.left = -size * aspect; env.orthographic.right = size * aspect; env.orthographic.top = size; env.orthographic.bottom = -size; env.orthographic.updateProjectionMatrix();
}

function alignGroundPlane(env: ViewerEnvironment, object: THREE.Object3D) {
  object.updateMatrixWorld(true);
  const bounds = new THREE.Box3().setFromObject(object, true);
  if (!Number.isFinite(bounds.min.y)) return;
  const groundY = bounds.min.y - .001;
  env.floor.position.y = groundY;
  env.grid.position.y = groundY + .0005;
}

function fitViewer(env: ViewerEnvironment, object: THREE.Object3D) {
  const sphere = new THREE.Box3().setFromObject(object).getBoundingSphere(new THREE.Sphere());
  if (!Number.isFinite(sphere.radius) || sphere.radius <= 0) return;
  const direction = env.activeCamera.position.clone().sub(env.controls.target).normalize(); if (!direction.lengthSq()) direction.set(1, .7, 1).normalize();
  const distance = sphere.radius * 3.2; env.activeCamera.position.copy(sphere.center).add(direction.multiplyScalar(distance));
  env.activeCamera.near = Math.max(sphere.radius / 100, .001); env.activeCamera.far = Math.max(sphere.radius * 30, 10);
  if (env.activeCamera instanceof THREE.OrthographicCamera) env.activeCamera.zoom = Math.max(0.2, 0.32 / sphere.radius);
  env.activeCamera.updateProjectionMatrix(); env.controls.target.copy(sphere.center); env.controls.update();
}

function setStandardView(env: ViewerEnvironment | undefined, view: 'iso' | 'front' | 'left' | 'top') {
  if (!env?.displayRoot) return;
  const sphere = new THREE.Box3().setFromObject(env.displayRoot).getBoundingSphere(new THREE.Sphere());
  const directions = { iso: new THREE.Vector3(1, .75, 1), front: new THREE.Vector3(1, 0, 0), left: new THREE.Vector3(0, 0, -1), top: new THREE.Vector3(0, 1, 0.001) };
  env.activeCamera.position.copy(sphere.center).add(directions[view].normalize().multiplyScalar(sphere.radius * 3.2)); env.controls.target.copy(sphere.center); env.controls.update();
}

function restoreCamera(env: ViewerEnvironment, state: Model3DViewState) {
  if (state.cameraPosition) env.activeCamera.position.fromArray(state.cameraPosition);
  if (state.cameraTarget) env.controls.target.fromArray(state.cameraTarget);
  if (state.cameraZoom) env.activeCamera.zoom = state.cameraZoom;
  env.activeCamera.updateProjectionMatrix(); env.controls.update();
}

function selectObject(env: ViewerEnvironment, object?: THREE.Object3D) {
  clearSelectionHighlight(env);
  const isModelRoot = object === env.modelRoot;
  if (!object || isModelRoot) return;
  object.traverse((child) => {
    if (!(child instanceof THREE.Mesh) || !child.visible) return;
    env.selectionMeshes.push(child);
    child.userData.aidcOriginalRenderOrder ??= child.renderOrder;
    child.renderOrder = 40;
    for (const material of selectedMaterials(child)) {
      material.color.lerp(new THREE.Color(0x24a99d), .5);
      material.emissive.set(0x075e57);
      material.emissiveIntensity = .3;
      material.depthTest = false;
      material.depthWrite = false;
      material.needsUpdate = true;
    }
  });
}

function objectIdFromObject(object: THREE.Object3D | null, objects: Map<string, THREE.Object3D>): string | undefined {
  if (!object) return undefined;
  const ids = new Map<THREE.Object3D, string>();
  for (const [id, candidate] of objects) ids.set(candidate, id);
  let current: THREE.Object3D | null = object;
  while (current) {
    const id = ids.get(current);
    if (id) return id;
    current = current.parent;
  }
  return undefined;
}

function physicalLabel(bodyId: string): string {
  return bodyId.replace(/^Body_/, '').replaceAll('_', ' ');
}

function flattenPhysicalTree(entries: PhysicalEntry[], expanded: Set<string>, search: string): PhysicalRow[] {
  const children = new Map<string | undefined, PhysicalEntry[]>();
  for (const entry of entries) {
    const siblings = children.get(entry.parentBodyId) ?? [];
    siblings.push(entry);
    children.set(entry.parentBodyId, siblings);
  }
  const term = search.trim().toLowerCase();
  const matches = (entry: PhysicalEntry): boolean => !term
    || `${entry.label} ${entry.bodyId} ${entry.componentIds.join(' ')}`.toLowerCase().includes(term)
    || (children.get(entry.bodyId) ?? []).some(matches);
  const rows: PhysicalRow[] = [];
  const visit = (entry: PhysicalEntry, depth: number) => {
    if (!matches(entry)) return;
    const descendants = children.get(entry.bodyId) ?? [];
    rows.push({ ...entry, depth, hasChildren: descendants.length > 0 });
    if (term || expanded.has(entry.bodyId)) descendants.forEach((child) => visit(child, depth + 1));
  };
  (children.get(undefined) ?? []).forEach((root) => visit(root, 0));
  return rows;
}

function clearSelectionHighlight(env: ViewerEnvironment) {
  for (const mesh of env.selectionMeshes) {
    mesh.renderOrder = Number(mesh.userData.aidcOriginalRenderOrder ?? 0);
    for (const material of selectedMaterials(mesh)) {
      material.color.setHex(Number(material.userData.aidcOriginalColor ?? 0xffffff));
      material.emissive.setHex(Number(material.userData.aidcOriginalEmissive ?? 0));
      material.emissiveIntensity = Number(material.userData.aidcOriginalEmissiveIntensity ?? 1);
      material.depthTest = material.userData.aidcOriginalDepthTest !== false;
      material.depthWrite = material.userData.aidcOriginalDepthWrite !== false;
      material.needsUpdate = true;
    }
  }
  env.selectionMeshes = [];
}

function selectedMaterials(mesh: THREE.Mesh): THREE.MeshStandardMaterial[] {
  const values = Array.isArray(mesh.material) ? mesh.material : [mesh.material];
  return values.filter((material): material is THREE.MeshStandardMaterial =>
    'emissive' in material && material.emissive instanceof THREE.Color,
  );
}

function motionDuration(manifest: Model3DManifest, from: JointPose, to: JointPose): number {
  let seconds = 0;
  for (const joint of manifest.joints) {
    const distance = Math.abs((to[joint.jointId] ?? joint.neutralValue) - (from[joint.jointId] ?? joint.neutralValue));
    const velocity = joint.limit?.velocity && joint.limit.velocity > 0 ? joint.limit.velocity : Math.PI;
    seconds = Math.max(seconds, distance / velocity);
  }
  return THREE.MathUtils.clamp(seconds * 1250, 450, 2400);
}

function createGhost(env: ViewerEnvironment) {
  clearGhost(env);
  if (!env.displayRoot) return;
  const ghost = env.displayRoot.clone(true);
  ghost.name = 'aidc-pose-ghost';
  ghost.traverse((object) => {
    if (!(object instanceof THREE.Mesh)) return;
    const source = Array.isArray(object.material) ? object.material : [object.material];
    const materials = source.map((material) => {
      const copy = material.clone(); copy.transparent = true; copy.opacity = .14; copy.depthWrite = false;
      if ('color' in copy && copy.color instanceof THREE.Color) copy.color.lerp(new THREE.Color(0x348f86), .6);
      return copy;
    });
    object.material = Array.isArray(object.material) ? materials : materials[0];
    object.renderOrder = -1;
  });
  env.ghostRoot = ghost; env.scene.add(ghost);
}

function clearGhost(env: ViewerEnvironment) {
  if (!env.ghostRoot) return;
  env.scene.remove(env.ghostRoot);
  env.ghostRoot.traverse((object) => {
    if (!(object instanceof THREE.Mesh)) return;
    for (const material of Array.isArray(object.material) ? object.material : [object.material]) material.dispose();
  });
  env.ghostRoot.clear(); env.ghostRoot = undefined;
}

function appendTrajectoryPoint(env: ViewerEnvironment, jointId: string) {
  const body = env.rig?.getBody(jointId); if (!body) return;
  env.scene.updateMatrixWorld(true);
  const point = body.getWorldPosition(new THREE.Vector3());
  const previous = env.trajectoryPoints.at(-1);
  if (previous && previous.distanceToSquared(point) < 1e-7) return;
  env.trajectoryPoints.push(point); if (env.trajectoryPoints.length > 240) env.trajectoryPoints.shift();
  if (!env.trajectory) {
    env.trajectory = new THREE.Line(new THREE.BufferGeometry(), new THREE.LineBasicMaterial({ color: 0xdf8b3d, transparent: true, opacity: .9, depthTest: false }));
    env.trajectory.renderOrder = 10; env.scene.add(env.trajectory);
  }
  env.trajectory.geometry.dispose(); env.trajectory.geometry = new THREE.BufferGeometry().setFromPoints(env.trajectoryPoints);
}

function clearTrajectory(env: ViewerEnvironment) {
  env.trajectoryPoints = [];
  if (!env.trajectory) return;
  env.scene.remove(env.trajectory); env.trajectory.geometry.dispose();
  const material = env.trajectory.material; if (Array.isArray(material)) material.forEach((item) => item.dispose()); else material.dispose();
  env.trajectory = undefined;
}

function applyAssemblyPosition(rig: AssemblyRig, sequence: AssemblySequence, position: number) {
  const value = THREE.MathUtils.clamp(position, 0, sequence.steps.length);
  if (value <= 0) { rig.reset(); return; }
  if (value >= sequence.steps.length) { rig.applySequence(sequence, sequence.steps.length - 1, 1); return; }
  if (Number.isInteger(value)) { rig.applySequence(sequence, value - 1, 1); return; }
  const index = Math.floor(value); rig.applySequence(sequence, index, value - index);
}

function createBomLabels(env: ViewerEnvironment, manifest: Model3DManifest) {
  clearBomLabels(env);
  const holder = new THREE.Group(); holder.name = 'aidc-bom-label-holder';
  const items: THREE.Sprite[] = [];
  const targetIds = new Set(env.assemblyRig?.componentIds ?? []);
  manifest.components.filter((component) => targetIds.has(component.componentId)).forEach((component, index) => {
    const object = env.components.get(component.componentId); if (!object) return;
    const canvas = document.createElement('canvas'); canvas.width = 512; canvas.height = 128;
    const context = canvas.getContext('2d'); if (!context) return;
    context.fillStyle = 'rgba(24,45,58,.90)'; context.roundRect(2, 2, 508, 124, 24); context.fill();
    context.fillStyle = '#5ed0bf'; context.font = '700 42px system-ui'; context.fillText(String(index + 1).padStart(2, '0'), 22, 79);
    context.fillStyle = '#ffffff'; context.font = '600 28px system-ui'; context.fillText(component.componentId, 100, 75);
    const texture = new THREE.CanvasTexture(canvas); texture.colorSpace = THREE.SRGBColorSpace;
    const material = new THREE.SpriteMaterial({ map: texture, transparent: true, depthTest: false });
    const sprite = new THREE.Sprite(material); sprite.name = `bom:${component.componentId}`; sprite.scale.set(.038, .0095, 1); sprite.renderOrder = 30;
    const center = new THREE.Box3().setFromObject(object, true).getCenter(new THREE.Vector3()); object.worldToLocal(center); sprite.position.copy(center).add(new THREE.Vector3(0, .012, 0));
    object.add(sprite); items.push(sprite);
  });
  holder.userData.items = items; env.bomLabels = holder;
}

function clearBomLabels(env: ViewerEnvironment) {
  const items = env.bomLabels?.userData.items as THREE.Sprite[] | undefined;
  for (const sprite of items ?? []) {
    sprite.removeFromParent(); const material = sprite.material as THREE.SpriteMaterial; material.map?.dispose(); material.dispose();
  }
  env.bomLabels = undefined;
}

function pathStatusLabel(status: AssemblySequence['steps'][number]['pathStatus']) {
  return ({ AUTO_SUGGESTED: '自动建议', MANUAL_DEMO: '人工演示', ENGINEERING_VERIFIED: '工程已验证' })[status];
}

function vectorLabel(vector: Vec3) { return `[${vector.map((value) => Number(value.toFixed(2))).join(', ')}]`; }

function downloadAssemblyReview(manifest: Model3DManifest, sequence: AssemblySequence, position: number, collisions: InterferencePairResult[]) {
  const payload = {
    schemaVersion: 'aidc.model3d.assembly-review/0.1', generatedAt: new Date().toISOString(),
    modelId: manifest.modelId, modelRevision: manifest.revision, sequencePosition: position,
    currentStep: position > 0 ? sequence.steps[Math.min(sequence.steps.length - 1, Math.ceil(position) - 1)]?.stepId : 'ASSEMBLED',
    collisionResults: collisions,
  };
  const url = URL.createObjectURL(new Blob([JSON.stringify(payload, null, 2)], { type: 'application/json' }));
  const link = document.createElement('a'); link.href = url; link.download = `${manifest.modelId}-assembly-review.json`; link.click(); URL.revokeObjectURL(url);
}

function mergeExactResults(preview: InterferencePairResult[], current: InterferencePairResult[]): InterferencePairResult[] {
  const exact = new Map(current.filter((item) => item.precision === 'BREP_EXACT').map((item) => [item.pairId, item]));
  return preview.map((item) => {
    const prior = exact.get(item.pairId);
    return prior && samePose(prior.pose, item.pose) ? prior : item;
  });
}

function samePose(left?: Record<string, number>, right?: Record<string, number>): boolean {
  if (!left || !right) return false;
  const keys = new Set([...Object.keys(left), ...Object.keys(right)]);
  return [...keys].every((key) => Math.abs((left[key] ?? 0) - (right[key] ?? 0)) < 1e-7);
}

function clearCollisionHighlights(env: ViewerEnvironment) {
  for (const helper of env.collisionHelpers) {
    env.scene.remove(helper); helper.geometry.dispose();
    const materials = Array.isArray(helper.material) ? helper.material : [helper.material]; materials.forEach((material) => material.dispose());
  }
  env.collisionHelpers = [];
}

function renderCollisionHighlights(env: ViewerEnvironment, results: InterferencePairResult[]) {
  clearCollisionHighlights(env);
  const ids = new Set(results.flatMap((item) => [item.componentA, item.componentB]));
  for (const componentId of ids) {
    const object = env.components.get(componentId); if (!object) continue;
    const helper = new THREE.Box3Helper(new THREE.Box3().setFromObject(object, true), new THREE.Color(0xd14f45));
    helper.renderOrder = 20;
    const materials = Array.isArray(helper.material) ? helper.material : [helper.material]; materials.forEach((material) => { material.depthTest = false; });
    env.scene.add(helper); env.collisionHelpers.push(helper);
  }
}

function fitViewerToComponents(env: ViewerEnvironment, componentIds: string[]) {
  const box = new THREE.Box3(); let found = false;
  for (const componentId of componentIds) {
    const object = env.components.get(componentId); if (!object) continue;
    box.union(new THREE.Box3().setFromObject(object, true)); found = true;
  }
  if (!found || box.isEmpty()) return;
  const sphere = box.getBoundingSphere(new THREE.Sphere());
  const direction = env.activeCamera.position.clone().sub(env.controls.target).normalize();
  env.activeCamera.position.copy(sphere.center).add(direction.multiplyScalar(Math.max(.05, sphere.radius * 3.5)));
  env.controls.target.copy(sphere.center); env.activeCamera.updateProjectionMatrix(); env.controls.update();
}

function collisionStatusLabel(status: InterferencePairResult['status']) {
  return ({ WARNING: '待校核', CONFIRMED: '已确认干涉', CLEARED: '已排除', ALLOWED_CONTACT: '允许接触', UNVERIFIED: '无法校核' })[status];
}

function formatVolume(value?: number) {
  if (value == null || !Number.isFinite(value)) return '—';
  return `${(value * 1e9).toFixed(value < 1e-9 ? 3 : 1)} mm³`;
}

function downloadScreenshot(env: ViewerEnvironment | undefined) {
  if (!env) return; env.renderer.render(env.scene, env.activeCamera);
  const link = document.createElement('a'); link.download = `aidc-model3d-${Date.now()}.png`; link.href = env.renderer.domElement.toDataURL('image/png'); link.click();
}

export const browserViews: BrowserViewDefinition[] = [{
  id: 'model3d.browser', label: '三维模型', hint: 'CAD 发布模型浏览', group: '三维浏览', icon: Box, component: Model3DBrowserView,
}];
