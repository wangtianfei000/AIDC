{
  "name": "aidc-sysml-browser",
  "private": true,
  "version": "0.9.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4173",
    "samples:sync": "node scripts/sync-samples.mjs",
    "samples:check": "node scripts/sync-samples.mjs --check",
    "build": "npm run samples:check && tsc -b && vite build",
