+    else if (m_resource) m_resource->addContent(calculation);
+    else { delete calculation; return nullptr; }
+    pushParent(calculation);
+    if (ctx->calculationBody()) visitCalculationBody(ctx->calculationBody());
+    popParent();
+    return calculation;
