+std::any ModelBuilderVisitor::visitCalculationDefinition(SysML::SysMLParser::CalculationDefinitionContext* ctx)
+{
+    if (!ctx || !ctx->definitionDeclaration()) return nullptr;
+    QString name = "UnnamedCalculation";
