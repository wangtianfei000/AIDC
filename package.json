{
  "name": "aidc-workspace",
  "private": true,
  "version": "0.9.0",
  "workspaces": [
    "sysml-browser",
    "modelica-browser/apps/*",
    "modelica-browser/packages/*",
    "model3d-viewer/apps/*",
    "model3d-viewer/packages/*"
  ],
  "scripts": {
    "clean": "powershell -NoProfile -ExecutionPolicy Bypass -File distribution/scripts/clean_workspace.ps1 -Execute",
    "clean:preview": "powershell -NoProfile -ExecutionPolicy Bypass -File distribution/scripts/clean_workspace.ps1",
    "clean:legacy": "powershell -NoProfile -ExecutionPolicy Bypass -File distribution/scripts/clean_workspace.ps1 -Execute -IncludeLegacyCopies",
    "clean:sysml-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File distribution/scripts/clean_workspace.ps1 -RuntimeBuildsOnly -Execute",
    "build:sysml-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File sysml-parser-runtime/build-runtime.ps1",
    "verify:sysml-engine:p5": "python -X utf8 sysml-parser-runtime/tools/verify_engine_maintenance.py && python -X utf8 sysml-parser-runtime/tools/verify_p4_self_contained.py",
    "dev:browser": "npm --workspace aidc-sysml-browser run dev",
    "dev:model3d": "npm --workspace @aidc/model3d-browser run dev",
    "build:model3d": "npm --workspace @aidc/model3d-browser run build",
    "test:model3d": "npm --workspace @aidc/model3d-contracts run test && npm --workspace @aidc/model3d-three-runtime run test",
    "publish:model3d:jingang": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/tools/freecad-publisher/run-freecad-publisher.ps1",
    "verify:model3d": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-v0.ps1",
    "verify:model3d:v1": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-v1.ps1",
    "verify:model3d:v2": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-v2.ps1",
    "verify:model3d:v3": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-v3.ps1",
    "serve:model3d:exact": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/services/exact-check/run.ps1",
    "verify:model3d:v4": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-v4.ps1",
    "verify:model3d:e5": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-e5.ps1",
    "verify:model3d:modelica-export": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/verify-modelica-export.ps1",
    "test:modelica:contracts": "npm --workspace @aidc/modelica-contracts test",
    "typecheck:modelica": "npm --workspace @aidc/modelica-contracts run typecheck",
    "verify:modelica:t1-1": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-t1-1.ps1",
    "verify:modelica:t1-2": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-t1-2.ps1",
    "build:modelica": "npm --workspace @aidc/modelica-browser-web run build",
    "dev:modelica": "npm --workspace @aidc/modelica-browser-web run dev",
    "verify:modelica:t1-3": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-t1-3.ps1",
    "verify:modelica:t1-4": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-t1-4.ps1",
    "verify:modelica:t1": "npm run verify:modelica:t1-1 && npm run verify:modelica:t1-2 && npm run verify:modelica:t1-3 && npm run verify:modelica:t1-4",
    "verify:modelica:t2": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-t2.ps1",
    "verify:modelica:native12": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-native12.ps1",
    "verify:modelica:p0-robotics": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p0-robotics.ps1",
    "verify:modelica:p1-robotics": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p1-robotics.ps1",
    "generate:modelica:p2": "python modelica-browser/tools/modelica_generator.py modelica-browser/packages/robot-ir/examples/single-joint modelica-browser/generated/p2-single-joint",
    "verify:modelica:p2-generator": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p2-generator.ps1",
    "generate:modelica:p3": "python modelica-browser/packages/robot-ir/examples/microduck-native12/build_bundle.py && python modelica-browser/tools/modelica_generator.py modelica-browser/packages/robot-ir/examples/microduck-native12 modelica-browser/generated/microduck-native12 --profile p3 --package MicroduckNative12",
    "verify:modelica:p3-generator": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p3-tree-generator.ps1",
    "build:modelica:native-geometry": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/build-native-geometry.ps1",
    "verify:modelica:p4-contact-runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p4-contact-runtime.ps1",
    "aidc:modelica": "python modelica-browser/tools/aidc_modelica.py",
    "package:modelica:aidc-robotics": "python modelica-browser/tools/package_aidc_robotics.py",
    "verify:modelica:p5-productization": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/verify-p5-productization.ps1",
    "create:modelica-from-model3d": "powershell -NoProfile -ExecutionPolicy Bypass -File model3d-viewer/scripts/create-modelica-project.ps1",
    "ci:modelica": "npm run test:modelica:contracts && npm run typecheck:modelica && npm run build:modelica && npm run verify:modelica:p5-productization",
    "serve:modelica": "powershell -NoProfile -ExecutionPolicy Bypass -File modelica-browser/scripts/start-project-server.ps1",
    "verify:distribution:p0": "python -X utf8 distribution/scripts/validate_p0.py",
    "test:cli": "python -X utf8 -m unittest discover -s tests/p1 -p test_*.py",
    "verify:geometry": "python -X utf8 -m unittest discover -s tests/p1 -p test_geometry_*.py -v",
    "verify:runtime:p1": "python -X utf8 tests/p1/verify_runtime.py",
    "build:distribution:p2": "powershell -NoProfile -ExecutionPolicy Bypass -File distribution/scripts/build_portable.ps1",
    "verify:distribution:p2": "python -X utf8 tests/p2/verify_portable.py",
    "test:runtime-packs:p3": "python -X utf8 -m unittest discover -s tests/p3 -p test_*.py",
    "verify:installer:p3": "python -X utf8 tests/p3/verify_installer.py",
    "verify:runtimes:p3": "python -X utf8 tests/p3/verify_engineering_runtimes.py",
    "verify:portable-runtimes:p3": "python -X utf8 tests/p3/verify_portable_runtimes.py",
    "verify:distribution:p3": "npm run test:runtime-packs:p3 && npm run verify:installer:p3 && npm run verify:runtimes:p3 && npm run verify:portable-runtimes:p3",
    "test:mcp:p4": "python -X utf8 -m unittest discover -s tests/p4 -p test_*.py -v",
    "verify:mcp-frozen:p4": "python -X utf8 tests/p4/verify_frozen_mcp.py",
    "verify:distribution:p4": "npm run test:mcp:p4 && npm run verify:mcp-frozen:p4",
    "test:integrations:p5": "python -X utf8 -m unittest discover -s tests/p5 -p test_*.py -v",
    "verify:hosts-frozen:p5": "python -X utf8 tests/p5/verify_frozen_hosts.py",
    "verify:distribution:p5": "npm run test:integrations:p5 && npm run verify:hosts-frozen:p5",
    "verify:release:p6": "python -X utf8 tests/p6/verify_release.py",
    "verify:distribution:p6": "npm run verify:distribution:p0 && npm run verify:distribution:p2 && npm run verify:distribution:p3 && npm run verify:distribution:p4 && npm run verify:distribution:p5 && npm run verify:release:p6"
  }
}
