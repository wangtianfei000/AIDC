{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/schemas/robot-ir/devices-0.1.json",
  "title": "AIDC Robot Devices",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "modelRevision", "devices"],
  "properties": {
    "schemaVersion": { "const": "aidc.robot.devices/0.1" },
    "modelId": { "$ref": "#/$defs/id" },
    "modelRevision": { "type": "string", "minLength": 1 },
    "devices": {
      "type": "array", "minItems": 1,
      "items": {
        "oneOf": [
          { "$ref": "#/$defs/actuator" },
          { "$ref": "#/$defs/sensor" },
          { "$ref": "#/$defs/power" }
        ]
      }
    }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "base": {
      "type": "object",
      "required": ["deviceId", "deviceType", "model"],
      "properties": {
        "deviceId": { "$ref": "#/$defs/id" },
        "deviceType": { "enum": ["actuator", "sensor", "power"] },
        "model": { "type": "string", "minLength": 1 }
      }
    },
    "actuator": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["deviceId", "deviceType", "model", "jointId", "commandKind", "gearRatio", "rotorInertia_kg_m2", "viscousDamping_Nm_s_rad", "effortLimit_Nm", "speedLimit_rad_s"],
          "properties": {
            "deviceId": { "$ref": "#/$defs/id" }, "deviceType": { "const": "actuator" }, "model": { "type": "string", "minLength": 1 },
            "jointId": { "$ref": "#/$defs/id" }, "commandKind": { "enum": ["torque", "position", "velocity"] },
            "gearRatio": { "type": "number", "exclusiveMinimum": 0 },
            "rotorInertia_kg_m2": { "type": "number", "minimum": 0 },
            "viscousDamping_Nm_s_rad": { "type": "number", "minimum": 0 },
            "effortLimit_Nm": { "type": "number", "exclusiveMinimum": 0 },
            "speedLimit_rad_s": { "type": "number", "exclusiveMinimum": 0 },
            "powerDeviceId": { "$ref": "#/$defs/id" }
          }
        }
      ]
    },
    "sensor": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["deviceId", "deviceType", "model", "sensorKind", "bodyId", "translation_m", "rotation_xyzw", "samplePeriod_s"],
          "properties": {
            "deviceId": { "$ref": "#/$defs/id" }, "deviceType": { "const": "sensor" }, "model": { "type": "string", "minLength": 1 },
            "sensorKind": { "enum": ["imu", "jointEncoder", "forceTorque"] },
            "bodyId": { "$ref": "#/$defs/id" },
            "jointId": { "$ref": "#/$defs/id" },
            "translation_m": { "$ref": "#/$defs/vec3" }, "rotation_xyzw": { "$ref": "#/$defs/quat" },
            "samplePeriod_s": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "power": {
      "allOf": [
        { "$ref": "#/$defs/base" },
        {
          "type": "object", "additionalProperties": false,
          "required": ["deviceId", "deviceType", "model", "nominalVoltage_V", "capacity_Ah", "internalResistance_Ohm", "currentLimit_A"],
          "properties": {
            "deviceId": { "$ref": "#/$defs/id" }, "deviceType": { "const": "power" }, "model": { "type": "string", "minLength": 1 },
            "nominalVoltage_V": { "type": "number", "exclusiveMinimum": 0 }, "capacity_Ah": { "type": "number", "exclusiveMinimum": 0 },
            "internalResistance_Ohm": { "type": "number", "minimum": 0 }, "currentLimit_A": { "type": "number", "exclusiveMinimum": 0 }
          }
        }
      ]
    },
    "vec3": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number" } },
    "quat": { "type": "array", "minItems": 4, "maxItems": 4, "items": { "type": "number" } }
  }
}
