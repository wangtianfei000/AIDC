{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/schemas/robot-ir/interfaces-0.1.json",
  "title": "AIDC Robot Interfaces",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "modelId", "modelRevision", "interfaceId", "interfaceVersion", "publicQuaternionOrder", "commands", "states", "diagnostics"],
  "properties": {
    "schemaVersion": { "const": "aidc.robot.interfaces/0.1" },
    "modelId": { "$ref": "#/$defs/id" },
    "modelRevision": { "type": "string", "minLength": 1 },
    "interfaceId": { "$ref": "#/$defs/id" },
    "interfaceVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "publicQuaternionOrder": { "const": "wxyz" },
    "commands": { "type": "array", "items": { "$ref": "#/$defs/channel" } },
    "states": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/channel" } },
    "diagnostics": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/channel" } }
  },
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$" },
    "channel": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "index", "semantic", "unit", "direction", "scale", "samplePeriod_s"],
      "properties": {
        "name": { "$ref": "#/$defs/id" },
        "index": { "type": "integer", "minimum": 1 },
        "semantic": { "enum": ["jointTorqueCommand", "jointPositionCommand", "jointVelocityCommand", "jointPosition", "jointVelocity", "jointAcceleration", "jointTorque", "valid", "limited", "statusCode"] },
        "unit": { "enum": ["N.m", "rad", "rad/s", "rad/s2", "1"] },
        "direction": { "enum": [-1, 1] },
        "scale": { "type": "number", "exclusiveMinimum": 0 },
        "samplePeriod_s": { "type": "number", "minimum": 0 },
        "jointId": { "$ref": "#/$defs/id" },
        "deviceId": { "$ref": "#/$defs/id" }
      }
    }
  }
}
