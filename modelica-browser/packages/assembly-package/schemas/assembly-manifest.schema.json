{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/schemas/robot-assembly/assembly-manifest-1.0.json",
  "title": "AIDC Robot Assembly Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "packageId", "modelId", "revision", "name", "source", "files"],
  "properties": {
    "schemaVersion": { "const": "aidc.robot.assembly/1.0" },
    "packageId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "modelId": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["format", "publisher", "publisherVersion"],
      "properties": {
        "format": { "enum": ["FCStd", "STEP", "JT", "glTF", "URDF", "other"] },
        "uri": { "type": "string", "minLength": 1 },
        "sha256": { "$ref": "#/$defs/sha256" },
        "publisher": { "type": "string", "minLength": 1 },
        "publisherVersion": { "type": "string", "minLength": 1 }
      }
    },
    "files": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256", "byteLength"],
        "properties": {
          "path": { "$ref": "#/$defs/relativePath" },
          "sha256": { "$ref": "#/$defs/sha256" },
          "byteLength": { "type": "integer", "minimum": 1 }
        }
      }
    }
  },
  "$defs": {
    "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?![/\\\\])(?!.*(?:^|[/\\\\])\\.\\.(?:[/\\\\]|$)).+$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
