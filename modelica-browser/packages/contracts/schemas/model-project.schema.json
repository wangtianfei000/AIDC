{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/modelica-browser/model-project.schema.json",
  "title": "AIDC Modelica project",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "projectId", "name", "revision", "description", "modelica"],
  "properties": {
    "schemaVersion": { "const": "2.0" },
    "projectId": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "name": { "type": "string", "minLength": 1 },
    "revision": { "type": "string", "minLength": 1 },
    "description": { "type": "string" },
    "modelica": {
      "type": "object", "additionalProperties": false,
      "required": ["rootPackageFile", "rootPackage", "defaultExperiment", "languageVersion", "libraries"],
      "properties": {
        "rootPackageFile": { "$ref": "#/$defs/relativePath" },
        "rootPackage": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_]*$" },
        "defaultExperiment": { "type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*$" },
        "languageVersion": { "type": "string", "minLength": 1 },
        "libraries": { "type": "array", "minItems": 1, "items": { "type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": { "name": { "type": "string", "minLength": 1 }, "version": { "type": "string", "minLength": 1 }, "path": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*\\\\).+$" } } } }
      }
    }
  },
  "$defs": { "relativePath": { "type": "string", "minLength": 1, "pattern": "^(?![A-Za-z]:)(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$" } }
}
