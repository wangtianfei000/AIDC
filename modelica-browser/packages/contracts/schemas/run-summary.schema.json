{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://aidc.local/modelica-browser/run-summary.schema.json",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "runId", "status", "finalTime", "variableCount"],
  "properties": { "schemaVersion": { "const": "2.0" }, "runId": { "type": "string", "minLength": 1 }, "status": { "enum": ["completed", "failed", "cancelled"] }, "finalTime": { "type": ["number", "null"] }, "variableCount": { "type": "integer", "minimum": 0 } }
}
