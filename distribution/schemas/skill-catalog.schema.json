{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/schemas/skill-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "catalogVersion", "skills"],
  "properties": {
    "schemaVersion": {"const": "aidc.skill-catalog/1.0"},
    "catalogVersion": {"type": "string"},
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "version", "path", "requiredCapabilities", "hosts"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
          "version": {"type": "string"},
          "path": {"type": "string"},
          "requiredCapabilities": {"type": "array", "items": {"type": "string"}},
          "hosts": {"type": "array", "minItems": 1, "items": {"enum": ["codex", "cursor", "mcp"]}}
        }
      }
    }
  }
}
