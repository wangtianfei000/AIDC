{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://aidc.local/schemas/component-manifest.schema.json",
  "title": "AIDC component manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "displayName", "version", "kind", "platform", "architecture", "capabilities", "entryPoints", "dependencies", "licenses", "distributionStatus", "healthCheck"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "id": {"type": "string", "pattern": "^aidc\\.[a-z0-9.-]+$"},
    "displayName": {"type": "string", "minLength": 1},
    "description": {"type": "string"},
    "version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:[-+][A-Za-z0-9.-]+)?$"},
    "kind": {"enum": ["cli", "mcp", "browser", "service", "library", "skill-pack", "runtime", "resource"]},
    "platform": {"enum": ["windows", "any"]},
    "architecture": {"enum": ["x86_64", "any"]},
    "protocolVersion": {"type": ["string", "null"]},
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9.-]+$"}
    },
    "entryPoints": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "relativePath", "mode"],
        "properties": {
          "id": {"type": "string"},
          "relativePath": {"type": "string", "minLength": 1},
          "mode": {"enum": ["executable", "stdio", "http", "static", "library", "resource"]},
          "arguments": {"type": "array", "items": {"type": "string"}}
        }
      }
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "versionRange", "required"],
        "properties": {
          "id": {"type": "string"},
          "versionRange": {"type": "string"},
          "required": {"type": "boolean"},
          "capability": {"type": ["string", "null"]}
        }
      }
    },
    "licenses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status"],
        "properties": {
          "name": {"type": "string"},
          "spdx": {"type": ["string", "null"]},
          "status": {"enum": ["approved", "review-required", "blocked"]},
          "noticePath": {"type": ["string", "null"]}
        }
      }
    },
    "distributionStatus": {"enum": ["internal", "candidate", "blocked", "approved"]},
    "healthCheck": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "timeoutSeconds"],
      "properties": {
        "type": {"enum": ["command", "http", "file", "none"]},
        "target": {"type": ["string", "null"]},
        "arguments": {"type": "array", "items": {"type": "string"}},
        "timeoutSeconds": {"type": "integer", "minimum": 1, "maximum": 300}
      }
    }
  }
}

