{
  "schemaVersion": "1.0",
  "id": "aidc.sysml",
  "displayName": "AIDC SysML Tools",
  "description": "Read-only SysML parsing, analysis and browser resources.",
  "version": "1.0.0",
  "kind": "browser",
  "platform": "windows",
  "architecture": "x86_64",
  "protocolVersion": "0.1",
  "capabilities": ["sysml.launch", "sysml.validate", "sysml.open", "sysml.snapshot"],
  "entryPoints": [
    {"id": "browser", "relativePath": "components/sysml/browser", "mode": "static", "arguments": []},
    {"id": "runtime", "relativePath": "components/sysml/bin/aidc-sysml-parser-runtime.exe", "mode": "http", "arguments": ["--port", "${AIDC_PORT}"]}
  ],
  "dependencies": [
    {"id": "sysml-parser-runtime", "versionRange": "1.0.0", "required": true, "capability": "sysml.parse"},
    {"id": "sysml-standard-library", "versionRange": "2026-08", "required": true, "capability": "sysml.library"}
  ],
  "licenses": [
    {"name": "AIDC project license decision pending", "spdx": null, "status": "review-required", "noticePath": "licenses/THIRD_PARTY_BASELINE.md"}
  ],
  "distributionStatus": "blocked",
  "healthCheck": {"type": "http", "target": "/health", "arguments": [], "timeoutSeconds": 30}
}

